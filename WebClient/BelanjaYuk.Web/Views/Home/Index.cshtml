@{
    ViewData["Title"] = "Home";
}

<div class="container mt-5">

    <!-- Hero Section -->
    <div class="row align-items-center py-5">

        <div class="col-lg-7">

            <p class="text-primary fw-semibold mb-2">
                BELANJAYUK
            </p>

            <h1 class="display-4 fw-bold mb-3">
                Belanja lebih mudah,
                <br />
                temukan produk pilihanmu.
            </h1>

            <p class="lead text-muted mb-4">
                BelanjaYuk menyediakan berbagai pilihan produk
                dari seller terpercaya dengan proses yang sederhana
                dan nyaman.
            </p>

            <div>
                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-primary btn-lg px-4">
                    Lihat Produk
                </a>

                <a asp-controller="Categories"
                   asp-action="Index"
                   class="btn btn-outline-secondary btn-lg px-4 ms-2">
                    Lihat Kategori
                </a>
            </div>

        </div>

        <div class="col-lg-5 mt-5 mt-lg-0">

            <div class="bg-light rounded-4 p-5 text-center">

                <svg xmlns="http://www.w3.org/2000/svg"
                     width="120"
                     height="120"
                     fill="currentColor"
                     class="text-primary"
                     viewBox="0 0 16 16">

                    <path d="M0 1.5A.5.5 0 0 1 .5 1h1a.5.5 0 0 1 .485.379L2.89 5H14.5a.5.5 0 0 1 .491.592l-1.5 7A.5.5 0 0 1 13 13H4a.5.5 0 0 1-.491-.408L1.01 2H.5a.5.5 0 0 1-.5-.5z" />

                    <path d="M5 14a1 1 0 1 0 0 2 1 1 0 0 0 0-2zm7 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2z" />

                </svg>

                <h5 class="mt-4">
                    BelanjaYuk
                </h5>

                <p class="text-muted mb-0">
                    Temukan produk yang kamu butuhkan.
                </p>

            </div>

        </div>

    </div>


    <!-- Feature Section -->
    <div class="row mt-5 pt-4">

        <div class="col-md-4 mb-4">

            <div class="card h-100 border-0 shadow-sm">

                <div class="card-body p-4">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="36"
                         height="36"
                         fill="currentColor"
                         class="text-primary mb-3"
                         viewBox="0 0 16 16">

                        <path d="M8 1a2 2 0 0 1 2 2v1h2.5A1.5 1.5 0 0 1 14 5.5v8A1.5 1.5 0 0 1 12.5 15h-9A1.5 1.5 0 0 1 2 13.5v-8A1.5 1.5 0 0 1 3.5 4H6V3a2 2 0 0 1 2-2zm1 3V3a1 1 0 0 0-2 0v1h2z" />

                    </svg>

                    <h5 class="card-title">
                        Pilihan Produk
                    </h5>

                    <p class="card-text text-muted">
                        Temukan berbagai produk yang tersedia
                        sesuai kebutuhanmu.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-4 mb-4">

            <div class="card h-100 border-0 shadow-sm">

                <div class="card-body p-4">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="36"
                         height="36"
                         fill="currentColor"
                         class="text-primary mb-3"
                         viewBox="0 0 16 16">

                        <path d="M3 2a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v1h1a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h1V2zm1 0v1h8V2H4zM2 4v9h12V4H2z" />

                    </svg>

                    <h5 class="card-title">
                        Kategori Terorganisir
                    </h5>

                    <p class="card-text text-muted">
                        Produk dikelompokkan berdasarkan kategori
                        agar lebih mudah ditemukan.
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-4 mb-4">

            <div class="card h-100 border-0 shadow-sm">

                <div class="card-body p-4">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="36"
                         height="36"
                         fill="currentColor"
                         class="text-primary mb-3"
                         viewBox="0 0 16 16">

                        <path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zM7 4h2v5H7V4zm0 6h2v2H7v-2z" />

                    </svg>

                    <h5 class="card-title">
                        Informasi Produk
                    </h5>

                    <p class="card-text text-muted">
                        Lihat informasi produk secara lebih lengkap
                        sebelum menentukan pilihan.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>