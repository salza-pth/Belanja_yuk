@model BelanjaYuk.Web.Models.ProfileViewModel

@{
    ViewData["Title"] = "Profile";
}

<div class="container mt-4 mb-5">

    <div class="mb-4">
        <h1 class="fw-bold">
            Profile
        </h1>

        <p class="text-muted">
            Informasi akun BelanjaYuk kamu.
        </p>
    </div>

    @if (TempData["ProfileSuccess"] != null)
    {
        <div class="alert alert-success">
            @TempData["ProfileSuccess"]
        </div>
    }

    @if (TempData["ProfileError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ProfileError"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <div class="row mb-3">

                <div class="col-md-6">
                    <label class="text-muted small">
                        User ID
                    </label>

                    <div class="fw-bold">
                        @Model.IdUser
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small">
                        Username
                    </label>

                    <div class="fw-bold">
                        @Model.UserName
                    </div>
                </div>

            </div>

            <hr />

            <div class="row mb-3">

                <div class="col-md-6">
                    <label class="text-muted small">
                        Nama Depan
                    </label>

                    <div>
                        @Model.FirstName
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small">
                        Nama Belakang
                    </label>

                    <div>
                        @Model.LastName
                    </div>
                </div>

            </div>

            <div class="row mb-3">

                <div class="col-md-6">
                    <label class="text-muted small">
                        Email
                    </label>

                    <div>
                        @Model.Email
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small">
                        Nomor Telepon
                    </label>

                    <div>
                        @Model.PhoneNumber
                    </div>
                </div>

            </div>

            <div class="row mb-4">

                <div class="col-md-6">
                    <label class="text-muted small">
                        Tanggal Lahir
                    </label>

                    <div>
                        @(string.IsNullOrEmpty(Model.DateOfBirth)
                            ? "-"
                            : DateTime.Parse(Model.DateOfBirth)
                                .ToString("dd/MM/yyyy"))
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small">
                        Gender
                    </label>

                    <div>
                        @(string.IsNullOrEmpty(Model.Gender)
                            ? "-"
                            : Model.Gender)
                    </div>
                </div>

            </div>

            <a asp-controller="Profile"
               asp-action="Edit"
               class="btn btn-primary">
                Edit Profile
            </a>

        </div>

    </div>

</div>